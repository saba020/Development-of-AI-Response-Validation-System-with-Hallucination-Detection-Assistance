# ==========================================
# Backend .gitignore
# ==========================================

# Environment variables & API keys (NEVER commit secrets!)
.env
.env.*
!.env.example
*.env

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Distribution & Packaging
build/
dist/
*.egg-info/

# Unit tests and coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# OS and Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
