# ==========================================
# Project .gitignore
# ==========================================

# Environment variables & secrets
.env
.env.*
!.env.example
*.env
*.env.*
!.env.*.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Node dependencies and build artifacts
node_modules/
dist/
dist-ssr/
build/
.vercel/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Python caches and environments
__pycache__/
*.py[cod]
venv/
.venv/
env/
ENV/
.pytest_cache/
.mypy_cache/

# Editor & OS files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
