# ==========================================
# Root .gitignore for AI Eval Sentinel
# Prevents accidental commits of secrets,
# virtual environments, and build artifacts.
# ==========================================

# Environment variables & secrets (NEVER commit secrets!)
.env
.env.*
!.env.example
*.env
*.env.*
!.env.*.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Node & Frontend dependencies and build outputs
node_modules/
dist/
dist-ssr/
build/
.cache/
.parcel-cache/
.next/
.output/

# Vercel deployment artifacts
.vercel/

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Type checking
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.pytype/
.ruff_cache/

# IDE & Editor configurations
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.sw?
*.sln
*.suo
*.ntvs*
*.njsproj

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
